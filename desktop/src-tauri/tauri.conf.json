{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPocket",
  "version": "0.1.0",
  "identifier": "com.local.agentpocket.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentPocket",
        "width": 760,
        "height": 620,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": ["icons/backend-*.png"]
  }
}
