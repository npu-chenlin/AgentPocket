{
  "name": "agentpocket-desktop",
  "private": true,
  "version": "2.18.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "build": "npm run check && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "dockview": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "com.local.agentpocket.desktop",
    "productName": "AgentPocket",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/*.png",
      "resources/*.ico",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
